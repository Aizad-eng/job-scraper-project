# Copy to job-scraper-backend/.env for local dev.
# On Render, set these under Environment (never commit real values).

# Password people must type to use the tool. Make it long and random.
APP_ACCESS_KEY=change-me-to-something-long-and-random

# Separate secret for the Apify / AI-Ark callbacks. Also long and random.
WEBHOOK_SECRET=change-me-too

MONGO_URI=
APIFY_TOKEN=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
AI_ARK_API_KEY=

# Your single Render service URL, no trailing slash.
PUBLIC_BASE_URL=https://job-scraper.onrender.com
