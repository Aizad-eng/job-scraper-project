# Copy to job-scraper-backend/.env for local dev.
# On Render, set these under Environment (never commit real values).

# Password people must type to use the tool. Make it long and random.
APP_ACCESS_KEY=change-me-to-something-long-and-random

# Separate secret for the Apify callbacks. Also long and random.
WEBHOOK_SECRET=change-me-too

MONGO_URI=
APIFY_TOKEN=

# Company-type check (is it a staffing agency?). ScrapingDog's Google AI Mode
# visits the company website; Claude turns a messy answer into JSON.
# 10 ScrapingDog credits per company checked.
SCRAPPINGDOG_KEY=
CLAUDE_KEY=

# Fallback classifiers, used only when the check above is not configured or
# gives no usable answer. Optional.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Most Apify actor runs allowed in flight at once, across all searches and
# schedules. Default 5. Raise it here if your Apify plan allows more.
MAX_ACTOR_RUNS=5

# Your single Render service URL, no trailing slash.
PUBLIC_BASE_URL=https://job-scraper.onrender.com
